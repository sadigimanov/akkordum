{
  "id": "asif-meherremov-gece-gece",
  "title": "Gecə Gecə",
  "artist": "Asif Məhərrəmov",
  "key": "Am",
  "capo": 2,
  "rhythm": ["↓", "-", "↑", "↑", "↑", "-", "↓", "↑", "↓", "↑"],
  "sections": [
    {
      "chords": [
        { "name": "Am", "offset": 0 }
      ],
      "line": "Səhər odu gün işığı, Yuxum odu gecə gecə."
    },
    {
      "chords": [
        { "name": "Dm", "offset": 0 },
        { "name": "F", "offset": 31 }
      ],
      "line": "Onu gəzib aramışam, Qapı qapı, küçə küçə."
    },
    {
      "chords": [
        { "name": "E", "offset": 10 }
      ],
      "line": "Düşünürəm içə içə..."
    },

    null,

    {
      "chords": [
        { "name": "Am", "offset": 0 }
      ],
      "line": "Onu salıb ürəyimə, Ürəyimi sıxan həyat"
    },
    {
      "chords": [
        { "name": "Dm", "offset": 0 },
        { "name": "F", "offset": 29 }
      ],
      "line": "Axı belə hara gedir, Axırıma çıxan həyat."
    },
    {
      "chords": [
        { "name": "E", "offset": 10 }
      ],
      "line": "Düz üzümə baxan həyat..."
    },

    null,

    {
      "label": "Keçid",
      "chords": [
        { "name": "Dm", "offset": 6 }
      ],
      "line": "Gizlincə aranı vurub,"
    },
    {
      "chords": [
        { "name": "Dm", "offset": 0 }
      ],
      "line": "Bizi ayırıb, məni bir yana çəkib atıb"
    },
    {
      "chords": [
        { "name": "Am", "offset": 0 }
      ],
      "line": "o, birini bir tərəfə"
    },
    {
      "chords": [
        { "name": "Am", "offset": 0 }
      ],
      "line": "Ya belə olub, ya da nə bilim,"
    },
    {
      "chords": [
        { "name": "Am", "offset": 0 }
      ],
      "line": "Mənə bəlkə də düşməyib hansı ki,"
    },
    {
      "chords": [
        { "name": "E", "offset": 10 },
        { "name": "Am", "offset": 34 }
      ],
      "line": "Sevən ərəfə, götürün içək bunu şərəfə..."
    },

    null,

    {
      "label": "Təkrar",
      "chords": [
        { "name": "Dm", "offset": 0 }
      ],
      "line": "Belədi həyat aranı vurub,"
    },
    {
      "chords": [
        { "name": "Dm", "offset": 0 }
      ],
      "line": "Bizi ayırıb, məni bir yana"
    },
    {
      "chords": [
        { "name": "Am", "offset": 11 }
      ],
      "line": "çəkib atıb o, birini bir tərəfə"
    },
    {
      "chords": [
        { "name": "Am", "offset": 0 }
      ],
      "line": "Ya belə olub, ya da nə bilim,"
    },
    {
      "chords": [
        { "name": "Am", "offset": 0 }
      ],
      "line": "Mənə bəlkə də düşməyib hansısa,"
    },
    {
      "chords": [
        { "name": "E", "offset": 9 }
      ],
      "line": "sevən ərəfə..."
    },
    {
      "chords": [
        { "name": "Am", "offset": 22 }
      ],
      "line": "Götürün içək bunu şərəfə..."
    }
  ]
}