  "rhythm": ["↓", "↑", "↑", "↓", "↑", "↑", "↓", "↑", "↓", "↑"],
  "sections": [
    {
      "chords": [
        { "name": "C#m", "offset": 0 },
        { "name": "F#m", "offset": 12 }
      ],
      "line": "Saçlarının rəngi payızdır"
    },
    {
      "chords": [
        { "name": "G#", "offset": 0 },
        { "name": "C#m", "offset": 12 }
      ],
      "line": "Gözlərinin rəngi dəniz"
    },
    {
      "chords": [
        { "name": "C#m", "offset": 0 },
        { "name": "F#m", "offset": 15 }
      ],
      "line": "Almaya bənzər yanağın var"
    },
    {
      "chords": [
        { "name": "G#", "offset": 0 },
        { "name": "C#m", "offset": 15 }
      ],
      "line": "Ay üzün aydan da təmiz"
    },

    null,

    {
      "chords": [
        { "name": "C#7", "offset": 0 },
        { "name": "F#m", "offset": 16 }
      ],
      "line": "Qönçə dodaqlarda gülüşlər"
    },
    {
      "chords": [
        { "name": "G#", "offset": 0 },
        { "name": "C#m", "offset": 14 }
      ],
      "line": "Yenə gözlərimə görünsün"
    },
    {
      "chords": [
        { "name": "A", "offset": 0 },
        { "name": "F#m", "offset": 15 }
      ],
      "line": "Məni məndən alan öpüşlər"
    },
    {
      "chords": [
        { "name": "G#", "offset": 0 },
        { "name": "C#m", "offset": 15 }
      ],
      "line": "Yenə ətrafıma bürünsün"
