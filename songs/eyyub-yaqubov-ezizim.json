        { "name": "C#m", "offset": 0 },
        { "name": "C#7", "offset": 8 },
        { "name": "F#m", "offset": 16 }
      ],
      "line": "Günləri saydım sənə çatdım, əzizim"
    },
    {
      "chords": [
        { "name": "G#", "offset": 0 },
        { "name": "C#m", "offset": 17 }
      ],
      "line": "Dərdi-qəmi başımdan atdım, əzizim"
    },
    {
      "chords": [
        { "name": "F#m", "offset": 0 },
        { "name": "C#m", "offset": 17 }
      ],
      "line": "Yuxuna gəlmək üçün, üzünü görmək üçün"
    },
    {
      "chords": [
        { "name": "D#", "offset": 0 },
        { "name": "G#", "offset": 13 },
        { "name": "C#m", "offset": 19 }
      ],
      "line": "Tək səni fikirləşib yatdım, əzizim"
