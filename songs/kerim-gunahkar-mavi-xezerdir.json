{
  "id": "kerim-gunahkar-mavi-xezerdir",
  "title": "Günahkar Mavi Xəzərdir",
  "artist": "Kərim",
  "key": "Bm",
  "capo": 0,
  "rhythm": ["↓", "↓", "↑", "↓", "↑"],
  "sections": [
    {
      "chords": [
        { "name": "Bm", "offset": 0 },
        { "name": "F#", "offset": 6 },
        { "name": "Bm", "offset": 24 }
      ],
      "line": "Eşit, ey nazlı Mələk, keçmişə bir eylə nəzər"
    },
    {
      "chords": [
        { "name": "Bm", "offset": 0 },
        { "name": "Em", "offset": 5 },
        { "name": "F#", "offset": 13 },
        { "name": "Bm", "offset": 22 }
      ],
      "line": "İki sevgim var idi qəlbdə sən, bir də Xəzər"
    },
    {
      "chords": [
        { "name": "Bm", "offset": 0 },
        { "name": "Em", "offset": 6 },
        { "name": "F#", "offset": 14 },
        { "name": "Bm", "offset": 25 }
      ],
      "line": "Siz idiz qəlbimə hakim, mənə candan da əziz"
    },
    {
      "chords": [
        { "name": "G", "offset": 0 },
        { "name": "Em", "offset": 6 },
        { "name": "F#", "offset": 16 },
        { "name": "Bm", "offset": 24 },
        { "name": "F#", "offset": 33 }
      ],
      "line": "Bir-birindən də gözəl; sən və ləlatümlü dəniz"
    },

    null,

    {
      "chords": [
        { "name": "Bm", "offset": 0 },
        { "name": "Em", "offset": 5 },
        { "name": "G", "offset": 11 },
        { "name": "F#", "offset": 19 }
      ],
      "line": "Indiki keçmişə edirsən nəzər"
    },
    {
      "chords": [
        { "name": "Em", "offset": 0 },
        { "name": "G", "offset": 5 },
        { "name": "F#", "offset": 11 },
        { "name": "Bm", "offset": 19 }
      ],
      "line": "De iki, sevgiyə axı kim dözər"
    },
    {
      "chords": [
        { "name": "Bm", "offset": 0 },
        { "name": "Em", "offset": 4 },
        { "name": "G", "offset": 10 },
        { "name": "F#", "offset": 18 }
      ],
      "line": "Ikimizdən birini sevərdin gərək"
    },
    {
      "chords": [
        { "name": "Em", "offset": 0 },
        { "name": "G", "offset": 5 },
        { "name": "F#", "offset": 11 },
        { "name": "Bm", "offset": 19 }
      ],
      "line": "Seçim etməliydin ya mən, ya Xəzər"
    },

    null,

    {
      "chords": [
        { "name": "Bm", "offset": 0 },
        { "name": "F#", "offset": 8 },
        { "name": "Bm", "offset": 26 }
      ],
      "line": "Bir zaman bu sahildə tapmışdım məhəbbətimi"
    },
    {
      "chords": [
        { "name": "Bm", "offset": 0 },
        { "name": "Em", "offset": 6 },
        { "name": "F#", "offset": 15 },
        { "name": "Bm", "offset": 22 }
      ],
      "line": "Aldı məndən apardı dalğalar səadətimi"
    },
    {
      "chords": [
        { "name": "Bm", "offset": 0 },
        { "name": "Em", "offset": 6 },
        { "name": "F#", "offset": 15 },
        { "name": "Bm", "offset": 23 }
      ],
      "line": "Yada saldıqca qulac dalğaların tellərini"
    },
    {
      "chords": [
        { "name": "G", "offset": 0 },
        { "name": "Em", "offset": 7 },
        { "name": "F#", "offset": 14 },
        { "name": "Bm", "offset": 23 },
        { "name": "F#", "offset": 28 }
      ],
      "line": "Gəzirəm həsrət ilə ötən gənclik illərini"
    },

    null,

    {
      "chords": [
        { "name": "Bm", "offset": 0 },
        { "name": "Em", "offset": 8 },
        { "name": "G", "offset": 14 },
        { "name": "F#", "offset": 24 }
      ],
      "line": "Bir vaxt yadındamı sənlə baş-başa"
    },
    {
      "chords": [
        { "name": "Em", "offset": 0 },
        { "name": "G", "offset": 5 },
        { "name": "F#", "offset": 9 },
        { "name": "Bm", "offset": 16 }
      ],
      "line": "Ikimiz sahili gəzərdik qoşa"
    },
    {
      "chords": [
        { "name": "Bm", "offset": 0 },
        { "name": "Em", "offset": 7 },
        { "name": "G", "offset": 15 },
        { "name": "F#", "offset": 23 }
      ],
      "line": "Bəlkə də günahkar mavi Xəzərdir"
    },
    {
      "chords": [
        { "name": "Em", "offset": 0 },
        { "name": "G", "offset": 7 },
        { "name": "F#", "offset": 14 },
        { "name": "Bm", "offset": 22 }
      ],
      "line": "Yetmədi bu nakam sevgimiz başa"
    }
  ]
}