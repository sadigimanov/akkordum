        { "name": "G", "offset": 7 },
        { "name": "Dm", "offset": 10 },
        { "name": "Em", "offset": 15 }
      ],
      "line": "Ayırır, ayırır bizi həsrət"
    },
    {
      "chords": [
        { "name": "F", "offset": 4 },
        { "name": "Em", "offset": 11 }
      ],
      "line": "Haradasan, səadət?"
    },
    {
      "chords": [
