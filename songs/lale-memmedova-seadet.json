  "sections": [
    {
      "chords": [
        { "name": "Am", "offset": 0 },
        { "name": "E", "offset": 17 }
      ],
      "line": "Vuruldu gözüm o qara gözlərinə"
    },
    {
      "chords": [
        { "name": "E", "offset": 0 },
        { "name": "Am", "offset": 17 }
      ],
      "line": "Aldandım, inan, o şirin sözlərinə"
    },
    {
      "chords": [
        { "name": "Am", "offset": 0 },
        { "name": "E", "offset": 18 }
      ],
      "line": "Çoxdan bilirdim gözlərin canlar alıb"
    },
    {
      "chords": [
        { "name": "Dm", "offset": 5 },
        { "name": "E", "offset": 15.7 },
        { "name": "Am", "offset": 22 }
      ],
      "line": "Dözüb baxdım, inan, gecəmə, gündüzümə"
    },
    null,
    {
      "chords": [
        { "name": "Am", "offset": 0 },
        { "name": "E", "offset": 9 }
      ],
      "line": "Haradasan, səadət?"
    },
    {
      "chords": [
        { "name": "Am", "offset": 0 },
        { "name": "E", "offset": 8 }
      ],
      "line": "Üzür məni həsrət"
    },
    {
      "chords": [
        { "name": "Am", "offset": 0 },
        { "name": "Dm", "offset": 5.6 }
      ],
      "line": "Ürəyim dolu"
