    {
      "chords": [
        { "name": "Dm", "offset": 4 },
        { "name": "C", "offset": 9.5 },
        { "name": "F", "offset": 18 },
        { "name": "B7", "offset": 26 }
      ],
      "line": "Ürəyimdə məhəbbət, məhəbbət, məhəbbət"
