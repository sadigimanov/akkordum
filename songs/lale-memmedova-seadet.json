    {
      "chords": [
        { "name": "F", "offset": 2 },
        { "name": "Dm", "offset": 10 },
        { "name": "E", "offset": 19 }
      ],
      "line": "Məhəbbət, məhəbbət, məhəbbət"
    },
    {
      "chords": [
        { "name": "E", "offset": 0 }
      ],
      "line": "Ya nəsib, ya qismət"
    },
    null,
    {
      "chords": [
        { "name": "Am", "offset": 4 },
        { "name": "G", "offset": 11 }
      ],
      "line": "Haradasan, səadət?"
