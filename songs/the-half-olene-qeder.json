    null,
    {
      "chords": [
        { "name": "Cm", "offset": 0 },
        { "name": "Fm", "offset": 15 }
      ],
      "line": "Biraz meyimdən içib danışıram,"
    },
    {
      "chords": [
        { "name": "A#", "offset": 0 },
        { "name": "G", "offset": 15 }
      ],
      "line": "Yalandan da olsa camaata qarışıram"
    },
    {
      "chords": [
        { "name": "Cm", "offset": 0 },
        { "name": "Fm", "offset": 15 }
      ],
      "line": "Bezirəm durub gedirəm gəzirəm"
