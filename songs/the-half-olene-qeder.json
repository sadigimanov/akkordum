        { "name": "Fm", "offset": 14 }
      ],
      "line": "Bu gün biraz yenə oturdum düşündüm"
    },
    {
      "chords": [
        { "name": "A#", "offset": 0 },
        { "name": "G", "offset": 15 }
      ],
      "line": "Ciddi ciddi ki, görən indi nələr olacaq"
